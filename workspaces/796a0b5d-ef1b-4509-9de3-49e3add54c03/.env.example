# ---------------------------------------------------------------------------
# Chat rate limiting
# ---------------------------------------------------------------------------

# Master switch. Set to false to disable enforcement entirely (handy locally).
RATE_LIMIT_ENABLED=true

# Maximum number of POST /chat requests allowed per key, per window.
# Must be a positive integer. Default: 10
RATE_LIMIT_CHAT_MAX_REQUESTS=10

# Length of the sliding window, in seconds. Must be a positive integer.
# Default: 60
RATE_LIMIT_CHAT_WINDOW_SECONDS=60

# Redis connection string used to share limiter state across processes and
# instances. Leave empty to use the in-process store (local dev / tests only -
# the limit is then per worker).
REDIS_URL=

# Connect/command timeout for the Redis client, in seconds. Keep this small so
# a hung Redis cannot add latency to /chat (the limiter fails open).
# Default: 0.25
REDIS_TIMEOUT_SECONDS=0.25

# ---------------------------------------------------------------------------
# Proxy handling (affects the IP fallback key for anonymous callers)
# ---------------------------------------------------------------------------

# Set to true only when the app runs behind a proxy you control.
TRUST_PROXY_HEADERS=false

# Comma separated list of proxy addresses to skip when reading X-Forwarded-For.
TRUSTED_PROXIES=
