# Copy to .env and adjust. Every variable overrides the matching key in
# config.json; unset variables fall back to the file, then to the built-in
# defaults shown below.

# --- Server ---------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s

# --- Database -------------------------------------------------------------
DATABASE_URL=postgres://localhost:5432/app?sslmode=disable
DATABASE_MAX_OPEN_CONNS=10

# --- Logging --------------------------------------------------------------
LOG_LEVEL=info

# --- Rate limiting --------------------------------------------------------
# NOTE: these values are parsed and validated at startup but are NOT yet
# enforced. Enforcement (the limiter middleware) arrives in a follow-up
# change; until then changing them has no effect on request handling.
#
# RATE_LIMIT_ENABLED  bool     default false  master on/off switch
# RATE_LIMIT_REQUESTS int      default 100    max requests per window (> 0)
# RATE_LIMIT_WINDOW   duration default 1m     window length (non-zero, e.g. 30s, 1m, 1h)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
