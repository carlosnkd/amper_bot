# Server
PORT=3000
# Number of proxies in front of the app (enables trust proxy when > 0)
TRUST_PROXY_HOPS=0

# Rate limiter for POST /api/items
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
# Comma-separated raw API keys that bypass the limiter entirely
RATE_LIMIT_TRUSTED_KEYS=
# Salt used when hashing API keys before they are used as store keys / logged
RATE_LIMIT_KEY_SALT=change-me

# Leave unset to use the in-memory store (single instance / local dev / tests)
# REDIS_URL=redis://127.0.0.1:6379
